module mux_2_1(
    input [3:0] A, B,
    input sel, 
    output [3:0] mux_out
);
    
 assign  mux_out = sel? B:A; 
endmodule

//-----------------Top Module//---------------------------

module Top(
input [3:0] A, B,
input Cin, S,
output [6:0] ca
    );
    
    wire [3:0] bcd_mux_out;
    wire [3:0] Sum_mux;
    wire C;
    wire [3:0] Cout_mux;
    
    assign Cout_mux = {3'b0,C};
    
    Bit4_adder uut1(.A(A),.B(B),.Cin(Cin),.Sum(Sum_mux),.Cout(C));
    mux_2_1 uut3(.A(Sum_mux),.B(Cout_mux),.sel(S),.mux_out(bcd_mux_out));
    BCD_7Seg_Decoder uut2 (.bcd(bcd_mux_out),.seg(ca));

      
endmodule




